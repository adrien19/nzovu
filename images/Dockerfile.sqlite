# Dockerfile with SQLite and PostgreSQL support
# Requires CGO for SQLite support
# Used for integration testing and development with full feature set

FROM golang:1.27.1-alpine3.24 as builder

# Install C compiler and musl-dev (required for CGO/SQLite)
RUN apk add --no-cache gcc musl-dev

# Set working directory
WORKDIR /build

# Copy dependency files first (better layer caching)
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY api api
COPY cmd/nzovu cmd/nzovu
COPY client client
COPY internal internal
COPY pkg pkg
COPY main.go ./

# Build arguments for version injection
ARG VERSION=dev
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown

# Build binary with SQLite support (CGO enabled)
RUN CGO_ENABLED=1 go build \
    -tags=sqlite \
    -ldflags="-X 'github.com/adrien19/nzovu/pkg/version.Version=${VERSION}' \
    -X 'github.com/adrien19/nzovu/pkg/version.GitCommit=${GIT_COMMIT}' \
    -X 'github.com/adrien19/nzovu/pkg/version.BuildDate=${BUILD_DATE}'" \
    -o nzovu \
    main.go

## Runtime stage - minimal image with just the binary
FROM alpine:3.24

ARG VERSION=dev
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown
LABEL org.opencontainers.image.title="Nzovu" \
      org.opencontainers.image.source="https://github.com/adrien19/nzovu" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.created="${BUILD_DATE}"

# Install runtime dependencies and timezone data for calendar schedules
RUN apk upgrade --no-cache && apk add --no-cache ca-certificates tzdata

# Set working directory
WORKDIR /

# Create necessary directories
RUN mkdir -p /config /secrets /data

# Copy binary from builder
COPY --from=builder /build/nzovu /nzovu

# Copy entrypoint script
COPY images/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Expose gRPC and HTTP ports
EXPOSE 9000 8080

# Use entrypoint script
ENTRYPOINT ["/entrypoint.sh"]
